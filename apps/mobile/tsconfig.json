{
  // Shared strict flags first; Expo's base comes last so its jsx/lib/module settings win.
  "extends": ["@libras/tsconfig/base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    // TypeScript 6 no longer includes every @types package by default.
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
