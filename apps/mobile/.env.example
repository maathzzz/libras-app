# Copy to .env for local development. Every EXPO_PUBLIC_* value ends up inside the app bundle.
# BFF URL. Android Emulator: http://10.0.2.2:3000; physical device: http://<your-LAN-IP>:3000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Project URL (Settings > Data API).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (Settings > API Keys > Publishable key). Never the secret key: it lives only in the BFF.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
