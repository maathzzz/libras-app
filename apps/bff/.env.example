# Copy to .env for local development. In production these come from Cloud Run.
NODE_ENV=development
PORT=3000
# Supabase pooler in transaction mode (Connect > Transaction pooler, port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Project URL (Settings > Data API). The JWKS and the token issuer come from it.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (Settings > API Keys > Secret keys), used only for the Auth admin API.
# It exists only in the BFF: never put it in the app, in EXPO_PUBLIC_* or in the repository.
SUPABASE_SECRET_KEY=sb_secret_<key>

# Only for `pnpm --filter bff dev:token`, which signs in a test user and prints its access
# token for manual requests. Never set these in Cloud Run.
# Publishable key (Settings > API Keys), the same one the app uses.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# A test user created in Authentication > Users. Do not use a real account.
DEV_USER_EMAIL=<test-user-email>
DEV_USER_PASSWORD=<test-user-password>
