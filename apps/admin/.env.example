# Same Supabase project as the app. Only the publishable key: the CMS signs in with Supabase
# Auth and gets every piece of content from the BFF.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# BFF address. Empty in development: Vite forwards /v1 to http://localhost:3000.
VITE_API_URL=
