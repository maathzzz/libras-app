# Same Supabase project as the app. Only the publishable key: the CMS signs in with Supabase
# Auth and gets every piece of content from the BFF.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where Next forwards /v1 (server only, never reaches the browser). Defaults to the local BFF.
BFF_URL=http://localhost:3000
